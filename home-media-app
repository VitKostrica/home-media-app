#!/bin/bash
# Home Media Center Launcher
# This script launches the Electron app from the installation directory

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ELECTRON_BIN="$APP_DIR/node_modules/.bin/electron"

if [[ ! -x "$ELECTRON_BIN" ]]; then
    echo "Error: Electron not found. Run: npm install" >&2
    exit 1
fi

cd "$APP_DIR" && NODE_ENV=production "$ELECTRON_BIN" "$APP_DIR" "$@"
