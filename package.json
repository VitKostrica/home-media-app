{
  "name": "home-media-app",
  "version": "0.1.0",
  "description": "Custom TV-like media center for Linux",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "kostra",
  "license": "MIT",
  "scripts": {
    "start": "npm run build-main && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "dev": "vite",
    "build": "npm run build-main && vite build",
    "build-main": "tsc --project tsconfig.main.json",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "cross-env NODE_ENV=development electron .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-is-dev": "^3.0.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  }
}
